# ============================================================
#  Root .gitignore for the Factory Traffic Management project
# ============================================================
#
#  This file applies to the whole repository. Each subfolder
#  (backend/, frontend/) can also have its own .gitignore with
#  more specific rules — those override / extend this one.
#
#  Order of precedence (highest first):
#     1. Inline `git add -f` (force)
#     2. Per-folder .gitignore
#     3. This root .gitignore
# ============================================================

# ------------------------------------------------------------
#  Private planning / scratch — DO NOT commit
# ------------------------------------------------------------
# Phase planning docs (kept locally for your own reference).
# Remove or change these lines if you want them in the repo.
/phases/

# ------------------------------------------------------------
#  Python (catches anything in the repo that isn't a venv)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------
#  Virtual environments
# ------------------------------------------------------------
venv/
env/
.venv/
ENV/
.python-version

# ------------------------------------------------------------
#  Tests / coverage / type-checkers / linters
# ------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyright_cache/
.tox/
.nox/
coverage.xml
*.cover
.cache/

# ------------------------------------------------------------
#  Secrets / environment
# ------------------------------------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ------------------------------------------------------------
#  Database files (SQLite is used by tests + dev)
# ------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------
#  Logs
# ------------------------------------------------------------
*.log
logs/

# ------------------------------------------------------------
#  OS / editor / IDE
# ------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~
.history/

# ------------------------------------------------------------
#  Build / distribution
# ------------------------------------------------------------
build/
dist/
*.egg-info/
*.egg
html/
site/

# ------------------------------------------------------------
#  Frontend (when added later)
# ------------------------------------------------------------
# node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# generic build outputs
frontend/dist/
frontend/build/
frontend/.next/
frontend/.nuxt/
frontend/.svelte-kit/
frontend/.cache/
frontend/.parcel-cache/
frontend/.vite/
frontend/coverage/

# env files inside frontend
frontend/.env
frontend/.env.local
frontend/.env.*.local
