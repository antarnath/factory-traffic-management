# Application
APP_NAME=factory-traffic
DEBUG=1
SECRET_KEY=replace-with-a-long-random-string

# Database
# Pick ONE of the following DB_URL values and comment out the others.
#
# 1. PostgreSQL (recommended) — install locally with:
#       sudo apt install postgresql
#       sudo -u postgres createuser traffic_user -P
#       sudo -u postgres createdb factory_traffic_db -O traffic_user
#    Then run:
#       alembic upgrade head
# DB_URL=postgresql+psycopg://traffic_user:your_password@127.0.0.1:5432/factory_traffic_db
#
# 2. MySQL — install locally with:
#       sudo apt install mysql-server
#       CREATE DATABASE factory_traffic_db;
#       CREATE USER 'traffic_user'@'localhost' IDENTIFIED BY 'your_password';
#       GRANT ALL ON factory_traffic_db.* TO 'traffic_user'@'localhost';
# DB_URL=mysql+pymysql://traffic_user:your_password@127.0.0.1:3306/factory_traffic_db?charset=utf8mb4
#
# 3. SQLite (only for quick local smoke tests; no row-locking guarantees):
DB_URL=sqlite:///./factory_traffic.db
